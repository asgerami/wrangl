{
  "name": "@asgerami/wrangl",
  "version": "0.5.0",
  "description": "Turn any REST API into an agent-ready MCP server in one command. Works from an OpenAPI spec, a Postman collection, or a base URL.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wrangl": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prebuilt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asgerami/wrangl.git"
  },
  "homepage": "https://github.com/asgerami/wrangl#readme",
  "bugs": {
    "url": "https://github.com/asgerami/wrangl/issues"
  },
  "author": {
    "name": "asgerami",
    "url": "https://github.com/asgerami"
  },
  "scripts": {
    "build": "tsc && cp src/controlplane/dashboard.html dist/controlplane/dashboard.html && node scripts/ensure-bin.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --test --import tsx ./test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepare": "node scripts/ensure-bin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "openapi",
    "swagger",
    "postman",
    "rest-api",
    "ai-agents",
    "llm",
    "claude",
    "cursor",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^15.0.0",
    "fastify": "^5.8.5",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
